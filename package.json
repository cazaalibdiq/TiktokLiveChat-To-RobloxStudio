// ============================================================================
// TikTok Live -> Roblox relay server
// Fixed to use tiktok-live-connector v2.x (via the /legacy compat export)
// so that `signApiKey` actually works. v1.2.3 silently ignored this option.
//
// package.json:
//   "dependencies": {
//     "express": "^4.19.2",
//     "cors": "^2.8.5",
//     "tiktok-live-connector": "^2.5.0"
//   }
//
// Railway env vars needed:
//   SIGN_API_KEY   -> your EulerStream API key (rename below if yours differs)
//   PORT           -> Railway sets this automatically, don't hardcode
// ============================================================================

const express = require('express');
const cors = require('cors');
// IMPORTANT: import from the "/legacy" subpath, NOT the package root.
// This is what still exposes the old WebcastPushConnection class/constructor
// shape in v2.x, so you don't have to rewrite the whole event-handling side.
const { WebcastPushConnection } = require('tiktok-live-connector/legacy');

const app = express();
app.use(cors());

const PORT = process.env.PORT || 3000;
const SIGN_API_KEY = process.env.SIGN_API_KEY || ''; // <-- rename if your Railway var has a different name

// ----------------------------------------------------------------------------
// Per-username connection state
// ----------------------------------------------------------------------------
// {
//   connection: WebcastPushConnection instance,
//   status: 'connecting' | 'connected' | 'disconnected' | 'error',
//   error: string | null,
//   events: [{ id, type, uniqueId, nickname, comment, timestamp }],
//   nextId: number,
//   lastCommentAt: Map<uniqueId, timestamp>  // for the cooldown gate below
// }
const rooms = new Map();

const MAX_BUFFERED_EVENTS = 200; // trim old events so memory doesn't grow forever
const PER_USER_COOLDOWN_MS = 1500; // tune to taste, or set to 0 to disable

function normalizeUsername(username) {
  return String(username || '').trim().replace(/^@/, '').toLowerCase();
}

// "Immediate-fire cooldown": the first event from a given viewer fires
// right away, then further events from that same viewer are dropped until
// the cooldown window passes. This is deliberately NOT a debounce (which
// would delay/collapse the first event too) - the first hit always lands
// immediately, only the spam after it gets suppressed.
function passesCooldown(room, uniqueId) {
  if (PER_USER_COOLDOWN_MS <= 0) return true;
  const now = Date.now();
  const last = room.lastCommentAt.get(uniqueId) || 0;
  if (now - last < PER_USER_COOLDOWN_MS) return false;
  room.lastCommentAt.set(uniqueId, now);
  return true;
}

function pushEvent(room, event) {
  event.id = room.nextId++;
  event.timestamp = Date.now();
  room.events.push(event);
  if (room.events.length > MAX_BUFFERED_EVENTS) {
    room.events.splice(0, room.events.length - MAX_BUFFERED_EVENTS);
  }
}

function getOrCreateRoom(username) {
  const uniqueId = normalizeUsername(username);
  if (rooms.has(uniqueId)) return rooms.get(uniqueId);

  const room = {
    connection: null,
    status: 'connecting',
    error: null,
    events: [],
    nextId: 1,
    lastCommentAt: new Map(),
  };
  rooms.set(uniqueId, room);

  const connection = new WebcastPushConnection(uniqueId, {
    signApiKey: SIGN_API_KEY,
    // fetchRoomInfoOnConnect: true (default) throws UserOfflineError if not live,
    // which we catch below instead of letting it swallow silently.
  });
  room.connection = connection;

  connection.connect()
    .then((state) => {
      room.status = 'connected';
      room.error = null;
      console.log(`[${uniqueId}] connected, roomId=${state?.roomId}`);
    })
    .catch((err) => {
      room.status = 'error';
      room.error = err?.message || String(err);
      console.error(`[${uniqueId}] connect failed:`, room.error);
    });

  connection.on('disconnected', () => {
    room.status = 'disconnected';
    console.log(`[${uniqueId}] disconnected`);
  });

  connection.on('error', (err) => {
    room.status = 'error';
    room.error = err?.message || String(err);
    console.error(`[${uniqueId}] runtime error:`, room.error);
  });

  connection.on('chat', (data) => {
    const viewerId = data?.user?.uniqueId || data?.uniqueId || 'unknown';
    if (!passesCooldown(room, viewerId)) return;
    pushEvent(room, {
      type: 'chat',
      uniqueId: viewerId,
      nickname: data?.user?.nickname || data?.nickname || viewerId,
      comment: data?.comment || '',
    });
  });

  return room;
}

// ----------------------------------------------------------------------------
// GET /comments?username=X&since=<lastId>
// Polled by the Roblox plugin. Returns only events newer than `since`.
// ----------------------------------------------------------------------------
app.get('/comments', (req, res) => {
  const username = req.query.username;
  if (!username) return res.status(400).json({ error: 'username query param required' });

  const room = getOrCreateRoom(username);
  const since = parseInt(req.query.since, 10) || 0;
  const newEvents = room.events.filter((e) => e.id > since);

  res.json({
    connected: room.status === 'connected',
    status: room.status,       // 'connecting' | 'connected' | 'disconnected' | 'error'
    error: room.error,         // now actually surfaced, not swallowed
    lastId: room.nextId - 1,
    events: newEvents,
  });
});

// ----------------------------------------------------------------------------
// GET /test?username=X
// Mirrors the old "Tes Koneksi" button: forces a fresh connect attempt and
// waits briefly so you get a real answer instead of the async race you had
// before (where the label checked status before connect() had resolved).
// ----------------------------------------------------------------------------
app.get('/test', async (req, res) => {
  const username = req.query.username;
  if (!username) return res.status(400).json({ error: 'username query param required' });

  const uniqueId = normalizeUsername(username);
  // Force a clean attempt rather than reusing a possibly-stuck old room.
  if (rooms.has(uniqueId)) {
    try { rooms.get(uniqueId).connection?.disconnect(); } catch (_) {}
    rooms.delete(uniqueId);
  }

  const room = getOrCreateRoom(username);

  // Give connect() a moment to settle instead of reporting instantly.
  const deadline = Date.now() + 8000;
  while (room.status === 'connecting' && Date.now() < deadline) {
    await new Promise((r) => setTimeout(r, 300));
  }

  res.json({
    connected: room.status === 'connected',
    status: room.status,
    error: room.error,
  });
});

app.get('/health', (_req, res) => res.json({ ok: true }));

app.listen(PORT, () => {
  console.log(`Relay server listening on port ${PORT}`);
  if (!SIGN_API_KEY) {
    console.warn('WARNING: SIGN_API_KEY is empty - connections will use the shared free sign server and may get rate-limited.');
  }
});
